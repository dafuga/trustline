{
  "name": "trustline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node node_modules/wrangler/bin/wrangler.js dev --local",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:http": "npm run build && node --test test/network.test.mjs",
    "check": "node node_modules/typescript/bin/tsc --noEmit && node --check test/network.test.mjs",
    "build": "node node_modules/wrangler/bin/wrangler.js deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "miniflare": "5.20261104.0-beta",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
