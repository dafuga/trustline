{
  "name": "trustline-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "workspaces": ["packages/protocol", "packages/relay", "packages/cli"],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
