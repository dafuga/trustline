{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trustline-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "CHANNELS", "class_name": "Channel" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailbox", "PairingRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["RateGate"] },
    { "tag": "v3", "new_sqlite_classes": ["Channel"] }
  ]
}
